# Required for live TinyFish Fetch requests. Never commit a real key.
# Create one at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# Optional ComponentPilot controls (defaults shown).
# COMPONENTPILOT_CACHE_TTL_MS=3600000
# COMPONENTPILOT_MAX_SOURCE_AGE_MS=300000

# Optional: replace the built-in source with 1-8 compatible sources.
# COMPONENTPILOT_SOURCES=[{"id":"example-catalogue","catalogue_url":"https://example.org/components/","design_systems_url":"https://example.org/design-systems"}]
